# Link cập nhập .env (đã khóa truy cập, chỉ có team): 
#https://drive.google.com/drive/folders/1q00f_8FjpV_3D1JZvzky_t77R6eZ7GRB?hl=vi

# Server Port (Render sets $PORT automatically, defaults to 8080 locally)
PORT=8080

# Google Gemini API Key for Neural Voice Generation
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model for Voice (gemini-3.8-flash-tts or gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Audio Output Directory (Points to frontend/public/audio for local serving or /tmp/audio for cloud)
AUDIO_OUTPUT_DIR=../frontend/public/audio

# Supabase PostgreSQL Connection (Session Pooler recommended for Spring Boot / Hibernate)
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.example
DB_PASSWORD=your_db_password_here

# JPA Settings
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# TTS Configuration: Switch between "azure" (default) or "gemini"
TTS_PROVIDER=azure

# Azure Speech Services (Free F0 Tier - 500,000 chars/month)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia

# Local Audio Cache Directory
TTS_CACHE_DIR=audio-cache

# Automatic failover between Azure and Gemini if primary fails
TTS_FALLBACK_ENABLED=true

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,https://viecultures.vercel.app

# JWT Authentication (32+ chars secret)
JWT_SECRET=viecultures-super-secret-jwt-signing-key-32-chars-long!
JWT_EXPIRATION_MS=604800000
