# Link cập nhật .env (đã khóa truy cập, chỉ có team): 
# https://drive.google.com/drive/folders/1q00f_8FjpV_3D1JZvzky_t77R6eZ7GRB?hl=vi

# Server Configuration
PORT=8080

# PostgreSQL Database Configuration (Supabase)
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your_project_id
DB_PASSWORD=your_db_password_here
DB_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA / Hibernate Settings
JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
HIBERNATE_FORMAT_SQL=false
SPRING_JPA_OPEN_IN_VIEW=false

# HikariCP Connection Pool Settings
HIKARI_MAX_POOL_SIZE=100
HIKARI_MIN_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=300000
HIKARI_MAX_LIFETIME=600000
HIKARI_KEEPALIVE_TIME=30000

# JSON Formatter
JACKSON_DATE_FORMAT=yyyy-MM-dd HH:mm:ss
JACKSON_TIME_ZONE=Asia/Ho_Chi_Minh

# Gemini AI Voice Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash-tts
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
AUDIO_OUTPUT_DIR=../frontend/public/audio

# Swagger OpenAPI & Swagger UI Configuration
SWAGGER_UI_PATH=/swagger-ui.html
SWAGGER_OPERATIONS_SORTER=method
SWAGGER_TAGS_SORTER=alpha
SWAGGER_API_DOCS_PATH=/v3/api-docs

# TTS Configuration & Provider Switch (azure | gemini)
TTS_PROVIDER=azure
TTS_CACHE_DIR=audio-cache
TTS_FALLBACK_ENABLED=true

# Azure Speech Configuration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=southeastasia

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8080,https://viecultures.vercel.app

# JWT Authentication Configuration (HMAC-SHA min 32 chars)
JWT_SECRET=your_32_chars_or_more_super_secret_jwt_key_here!
JWT_EXPIRATION_MS=604800000

# Mail Configuration (Gmail SMTP - App Password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_chars_google_app_password
MAIL_FROM_NAME=VieCultures Team

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
